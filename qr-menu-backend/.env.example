# .env.example
# Copy this file to .env and fill in the real values
# Supabase / PostgreSQL connection
DB_HOST=your-db-host.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_password

# JWT secret for admin auth (change to a strong random string)
JWT_SECRET=your_super_secret_here


